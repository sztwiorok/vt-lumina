{
  "name": "lumina-apparel",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 3000 --no-clipboard",
    "lint": "next lint",
